[Unit]
Description=ReleasePlan Gunicorn Service
After=network.target

[Service]
Type=simple
User={{RUN_USER}}
WorkingDirectory={{BASE_DIR}}
EnvironmentFile={{BASE_DIR}}/.env
ExecStart={{BASE_DIR}}/.venv/bin/gunicorn --workers 2 --bind {{HOST}}:{{PORT}} wsgi:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
