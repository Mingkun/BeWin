{
  "strict": true,
  "debug": false,
  "sp": {
    "entityId": "https://your-domain.example.com/releaseplan/saml/metadata",
    "assertionConsumerService": {
      "url": "https://your-domain.example.com/releaseplan/saml/acs",
      "binding": "urn:oasis:names:tc:SAML:2.0:bindings:HTTP-POST"
    },
    "singleLogoutService": {
      "url": "https://your-domain.example.com/releaseplan/saml/logout",
      "binding": "urn:oasis:names:tc:SAML:2.0:bindings:HTTP-Redirect"
    },
    "x509cert": "",
    "privateKey": ""
  },
  "idp": {
    "entityId": "https://idp.example.com/entity-id",
    "singleSignOnService": {
      "url": "https://idp.example.com/sso",
      "binding": "urn:oasis:names:tc:SAML:2.0:bindings:HTTP-Redirect"
    },
    "singleLogoutService": {
      "url": "https://idp.example.com/slo",
      "binding": "urn:oasis:names:tc:SAML:2.0:bindings:HTTP-Redirect"
    },
    "x509cert": "REPLACE_WITH_IDP_X509_CERT"
  },
  "security": {
    "wantAssertionsSigned": true,
    "wantMessagesSigned": false,
    "wantNameId": true
  }
}
