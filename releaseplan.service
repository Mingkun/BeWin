[Unit]
Description=ReleasePlan Gunicorn Service
After=network.target

[Service]
User=root
WorkingDirectory=/work/ReleasePlan
EnvironmentFile=/work/ReleasePlan/.env
ExecStart=/usr/local/bin/gunicorn --workers 1 --bind 127.0.0.1:5010 wsgi:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
